generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model SavedDeck {
  id        Int      @id @default(autoincrement())
  name      String
  cardIds   String // JSON配列をシリアライズ: '["N01","N03",...]'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
