generator client {
  provider = "prisma-client-js"
  // native: ホスト(macOS)用 / debian-openssl-3.0.x: Dockerコンテナ(node:20-slim)用
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model SavedDeck {
  id          Int      @id @default(autoincrement())
  name        String
  cardIds     String // JSON配列をシリアライズ: '["N01","N03",...]'
  poolCardIds String? // デッキ構築元の手持ちカード(開封した40枚)。編集時の選び直しに使う
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
